generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS DEL DOMINIO
// ============================================================================

enum RoleCode {
  ADMIN_GERENCIA
  CONTADOR_TESORERIA
  CAJERO
  VENDEDOR_MOSTRADOR
  BODEGUERO
  DESPACHADOR_LOGISTICA
}

enum WarehouseType {
  MOSTRADOR
  ALMACEN_CERRADO
  PATIO_GRANELES
  CUARENTENA_AVERIAS
  CUSTODIA_VIRTUAL
  EN_TRANSITO_VIRTUAL
}

enum FiscalDocumentType {
  FACTURA_ELECTRONICA
  TIRILLA_POS
  FACTURA_CONTINGENCIA
  NOTA_CREDITO
  NOTA_DEBITO
  REMISION
  RECIBO_CAJA
  ORDEN_COMPRA
  VALE_CUSTODIA
  TRASLADO
}

enum KardexMovementType {
  COMPRA_RECEPCION
  VENTA_POS
  VENTA_CUSTODIA_RESERVA
  ENTREGA_CUSTODIA
  CANCELACION_CUSTODIA
  DEVOLUCION_VENTA_VENDIBLE
  DEVOLUCION_VENTA_AVERIA
  DEVOLUCION_PROVEEDOR
  TRASLADO_SALIDA
  TRASLADO_ENTRADA
  FRACCIONAMIENTO_SALIDA
  FRACCIONAMIENTO_ENTRADA
  MERMA_CORTE
  AJUSTE_POSITIVO
  AJUSTE_NEGATIVO
  KIT_EXPLOSION_SALIDA
}

enum PurchaseOrderStatus {
  BORRADOR
  APROBADA
  PARCIALMENTE_RECIBIDA
  RECIBIDA
  ANULADA
}

enum GoodsReceiptStatus {
  BORRADOR
  CON_DISCREPANCIA
  APROBADA
  ANULADA
}

enum TransferStatus {
  EN_TRANSITO
  RECIBIDO_COMPLETO
  RECIBIDO_CON_FALTANTE
  ANULADO
}

enum CycleCountStatus {
  ABIERTO
  RECONTEO_REQUERIDO
  PENDIENTE_APROBACION
  CERRADO
}

enum CustomerSegment {
  MOSTRADOR
  MAYORISTA
  CONTRATISTA
  CONVENIO
}

enum InvoiceDeliveryMode {
  RETIRO_INMEDIATO
  DESPACHO_DOMICILIO
  ENTREGA_PARCIAL_CUSTODIA
}

enum InvoiceStatus {
  EMITIDA_LOCAL
  TRANSMITIDA_DIAN
  CONTINGENCIA_PENDIENTE
  ANULADA_PRE_TRANSMISION
  CON_NOTA_CREDITO_PARCIAL
  CON_NOTA_CREDITO_TOTAL
}

enum DispatchStatus {
  PENDIENTE_ALISTAMIENTO
  EN_ALISTAMIENTO
  CARGADO
  EN_RUTA
  ENTREGADO
  ENTREGA_PARCIAL
  RECHAZADO
}

enum PaymentMethod {
  EFECTIVO
  TARJETA_DEBITO
  TARJETA_CREDITO
  TRANSFERENCIA
  CHEQUE
  CREDITO_INTERNO
  SALDO_A_FAVOR
}

enum CashShiftStatus {
  ABIERTO
  CERRADO
}

enum CommissionBasis {
  VENTA_FACTURADA
  VENTA_RECAUDADA
}

enum PayrollStatus {
  PRE_NOMINA
  CERRADA
}

enum FraudSeverity {
  MEDIA
  ALTA
  CRITICA
}

// ============================================================================
// MÓDULO 1: CONFIGURACIÓN, SEGURIDAD (RBAC), SEDES Y PARÁMETROS FISCALES
// ============================================================================

model Branch {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(20)
  name      String   @db.VarChar(120)
  address   String   @db.VarChar(250)
  city      String   @db.VarChar(80)
  phone     String?  @db.VarChar(30)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  warehouses        Warehouse[]
  posTerminals      PosTerminal[]
  users             User[]
  fiscalResolutions FiscalResolution[]
  invoices          Invoice[]
  cashShifts        CashShift[]
  expenses          Expense[]
  employees         Employee[]

  @@map("branches")
}

model Warehouse {
  id                String        @id @default(uuid()) @db.Uuid
  branchId          String        @db.Uuid
  code              String        @unique @db.VarChar(25)
  name              String        @db.VarChar(120)
  type              WarehouseType
  allowsDirectSales Boolean       @default(false)
  allowsDispatch    Boolean       @default(true)
  allowsReceiving   Boolean       @default(false)
  isActive          Boolean       @default(true)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  branch             Branch              @relation(fields: [branchId], references: [id])
  locations          WarehouseLocation[]
  inventoryBalances  InventoryBalance[]
  kardexMovements    KardexMovement[]
  purchaseOrders     PurchaseOrder[]
  goodsReceipts      GoodsReceipt[]
  transfersOut       StockTransfer[]     @relation("TransferOrigin")
  transfersIn        StockTransfer[]     @relation("TransferDestination")
  cycleCounts        CycleCount[]
  defaultForTerminal PosTerminal[]

  @@index([branchId, type])
  @@map("warehouses")
}

model WarehouseLocation {
  id          String  @id @default(uuid()) @db.Uuid
  warehouseId String  @db.Uuid
  zone        String  @db.VarChar(20)
  aisle       String  @db.VarChar(20)
  rack        String  @db.VarChar(20)
  level       String  @db.VarChar(20)
  barcode     String  @unique @db.VarChar(60)
  isActive    Boolean @default(true)

  warehouse Warehouse                  @relation(fields: [warehouseId], references: [id])
  skuLinks  ProductWarehouseLocation[]

  @@unique([warehouseId, zone, aisle, rack, level])
  @@map("warehouse_locations")
}

model Role {
  id                  String   @id @default(uuid()) @db.Uuid
  code                RoleCode @unique
  name                String   @db.VarChar(80)
  canViewCosts        Boolean  @default(false) // Enmascaramiento (*)
  canViewCashExpected Boolean  @default(false) // Arqueo ciego (*)
  canApproveOverride  Boolean  @default(false) // Habilita PIN supervisor
  createdAt           DateTime @default(now())

  permissions RolePermission[]
  users       User[]

  @@map("roles")
}

model Permission {
  id          String @id @default(uuid()) @db.Uuid
  resource    String @db.VarChar(60) // ej: "inventory.catalog", "pos.invoice"
  action      String @db.VarChar(10) // "L", "C", "E", "A", "N"
  description String @db.VarChar(200)

  roles RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model RolePermission {
  roleId          String  @db.Uuid
  permissionId    String  @db.Uuid
  ownRecordsOnly  Boolean @default(false) // Restricción (*) a registros propios
  maskedSensitive Boolean @default(false) // Restricción (*) sin costos/saldos

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id                String    @id @default(uuid()) @db.Uuid
  branchId          String    @db.Uuid
  roleId            String    @db.Uuid
  username          String    @unique @db.VarChar(50)
  email             String    @unique @db.VarChar(120)
  fullName          String    @db.VarChar(140)
  passwordHash      String    @db.VarChar(255) // Argon2id
  supervisorPinHash String?   @db.VarChar(255) // Argon2id para PIN dinámico
  allowedWorkStart  String?   @db.VarChar(5) // "06:00"
  allowedWorkEnd    String?   @db.VarChar(5) // "20:00"
  isActive          Boolean   @default(true)
  failedLoginCount  Int       @default(0)
  lockedUntil       DateTime?
  lastActivityAt    DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  branch             Branch                  @relation(fields: [branchId], references: [id])
  role               Role                    @relation(fields: [roleId], references: [id])
  overridesRequested SupervisorOverrideLog[] @relation("OverrideRequester")
  overridesApproved  SupervisorOverrideLog[] @relation("OverrideApprover")
  cashShifts         CashShift[]
  kardexMovements    KardexMovement[]
  invoicesAsCashier  Invoice[]               @relation("InvoiceCashier")
  invoicesAsSeller   Invoice[]               @relation("InvoiceSeller")
  auditLogs          AuditLog[]
  employee           Employee?

  @@index([branchId, isActive])
  @@map("users")
}

model SupervisorOverrideLog {
  id            String    @id @default(uuid()) @db.Uuid
  requesterId   String    @db.Uuid
  approverId    String    @db.Uuid
  actionCode    String    @db.VarChar(60)
  reason        String    @db.VarChar(250)
  referenceType String    @db.VarChar(60)
  referenceId   String    @db.VarChar(80)
  usedAt        DateTime?
  expiresAt     DateTime
  createdAt     DateTime  @default(now())

  requester User @relation("OverrideRequester", fields: [requesterId], references: [id])
  approver  User @relation("OverrideApprover", fields: [approverId], references: [id])

  @@index([requesterId, createdAt])
  @@index([approverId, createdAt])
  @@map("supervisor_override_logs")
}

model TaxRule {
  id            String   @id @default(uuid()) @db.Uuid
  code          String   @unique @db.VarChar(30) // ej: "IVA_19", "IVA_5", "IVA_0", "RETEFUENTE_2_5"
  name          String   @db.VarChar(100)
  taxType       String   @db.VarChar(30) // IVA, RETEFUENTE, RETEICA, INC
  ratePercent   Decimal  @db.Decimal(7, 4)
  minBaseAmount Decimal  @default(0) @db.Decimal(18, 4)
  isRetention   Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  products Product[]

  @@map("tax_rules")
}

model FiscalResolution {
  id               String             @id @default(uuid()) @db.Uuid
  branchId         String             @db.Uuid
  documentType     FiscalDocumentType
  resolutionNumber String             @db.VarChar(60)
  prefix           String             @db.VarChar(15)
  rangeStart       BigInt
  rangeEnd         BigInt
  currentNumber    BigInt
  validFrom        DateTime
  validUntil       DateTime
  isContingency    Boolean            @default(false)
  isActive         Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  branch         Branch        @relation(fields: [branchId], references: [id])
  posTerminals   PosTerminal[] @relation("PrimaryResolution")
  contingencyFor PosTerminal[] @relation("ContingencyResolution")

  @@unique([branchId, prefix, documentType])
  @@map("fiscal_resolutions")
}

model PosTerminal {
  id                      String   @id @default(uuid()) @db.Uuid
  branchId                String   @db.Uuid
  defaultWarehouseId      String   @db.Uuid
  primaryResolutionId     String?  @db.Uuid
  contingencyResolutionId String?  @db.Uuid
  code                    String   @unique @db.VarChar(30)
  name                    String   @db.VarChar(100)
  maxCashAllowed          Decimal  @db.Decimal(18, 4)
  thermalPrinterConfig    Json?
  laserPrinterConfig      Json?
  scaleSerialConfig       Json?
  isActive                Boolean  @default(true)
  createdAt               DateTime @default(now())

  branch                Branch            @relation(fields: [branchId], references: [id])
  defaultWarehouse      Warehouse         @relation(fields: [defaultWarehouseId], references: [id])
  primaryResolution     FiscalResolution? @relation("PrimaryResolution", fields: [primaryResolutionId], references: [id])
  contingencyResolution FiscalResolution? @relation("ContingencyResolution", fields: [contingencyResolutionId], references: [id])
  cashShifts            CashShift[]
  drawerEvents          CashDrawerEvent[]

  @@map("pos_terminals")
}

model CashDrawerEvent {
  id           String   @id @default(uuid()) @db.Uuid
  terminalId   String   @db.Uuid
  userId       String   @db.Uuid
  shiftId      String?  @db.Uuid
  reason       String   @db.VarChar(120) // SALE, REFUND, MANUAL_OVERRIDE, ANOMALOUS
  isAuthorized Boolean  @default(false)
  createdAt    DateTime @default(now())

  terminal PosTerminal @relation(fields: [terminalId], references: [id])

  @@index([terminalId, createdAt])
  @@map("cash_drawer_events")
}

model AccountingPeriod {
  id        String    @id @default(uuid()) @db.Uuid
  year      Int
  month     Int
  isClosed  Boolean   @default(false)
  closedBy  String?   @db.Uuid
  closedAt  DateTime?
  createdAt DateTime  @default(now())

  @@unique([year, month])
  @@map("accounting_periods")
}

// ============================================================================
// MÓDULO 2: INVENTARIO, MOTOR DE UM, KITS, COMPRAS Y KARDEX
// ============================================================================

model Category {
  id                  String   @id @default(uuid()) @db.Uuid
  parentId            String?  @db.Uuid
  code                String   @unique @db.VarChar(30)
  name                String   @db.VarChar(100)
  maxShrinkagePercent Decimal  @default(0) @db.Decimal(5, 2) // CB-05 Tope merma corte
  minMarginPercent    Decimal  @default(10) @db.Decimal(5, 2)
  createdAt           DateTime @default(now())

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@map("categories")
}

model Brand {
  id       String    @id @default(uuid()) @db.Uuid
  name     String    @unique @db.VarChar(80)
  products Product[]

  @@map("brands")
}

model UnitOfMeasure {
  id            String  @id @default(uuid()) @db.Uuid
  code          String  @unique @db.VarChar(15) // UND, M, CM, G, KG, ML, L, TON, M3, BTO, RLL
  name          String  @db.VarChar(60)
  allowDecimals Boolean @default(false)

  baseProducts Product[]               @relation("BaseUom")
  conversions  ProductUnitConversion[]

  @@map("units_of_measure")
}

model Product {
  id               String   @id @default(uuid()) @db.Uuid
  sku              String   @unique @db.VarChar(40)
  manufacturerRef  String?  @db.VarChar(60)
  name             String   @db.VarChar(200)
  description      String?  @db.Text
  categoryId       String   @db.Uuid
  brandId          String?  @db.Uuid
  baseUomId        String   @db.Uuid
  taxRuleId        String   @db.Uuid
  specs            Json? // calibre, diámetro, amperaje, etc.
  weightKg         Decimal  @default(0) @db.Decimal(12, 4) // Para cálculo de fletes (RF-16)
  volumeM3         Decimal  @default(0) @db.Decimal(12, 6)
  baseSalePrice    Decimal  @db.Decimal(18, 4)
  minMarginPercent Decimal? @db.Decimal(5, 2) // Sobrescribe categoría
  isKit            Boolean  @default(false)
  requiresSerial   Boolean  @default(false) // Maquinaria pesada
  isCuttable       Boolean  @default(false) // Habilita merma por corte
  isWeighable      Boolean  @default(false) // Lectura desde báscula
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  category          Category                   @relation(fields: [categoryId], references: [id])
  brand             Brand?                     @relation(fields: [brandId], references: [id])
  baseUom           UnitOfMeasure              @relation("BaseUom", fields: [baseUomId], references: [id])
  taxRule           TaxRule                    @relation(fields: [taxRuleId], references: [id])
  barcodes          ProductBarcode[]
  unitConversions   ProductUnitConversion[]
  locations         ProductWarehouseLocation[]
  kitComponents     ProductKitItem[]           @relation("KitParent")
  partOfKits        ProductKitItem[]           @relation("KitComponent")
  substitutes       ProductRelation[]          @relation("ProductSource")
  relatedBy         ProductRelation[]          @relation("ProductTarget")
  inventoryBalances InventoryBalance[]
  kardexMovements   KardexMovement[]
  serials           ProductSerial[]
  priceListItems    PriceListItem[]
  purchaseItems     PurchaseOrderItem[]
  receiptItems      GoodsReceiptItem[]
  invoiceItems      InvoiceItem[]
  creditNoteItems   CreditNoteItem[]

  @@index([name])
  @@index([categoryId, isActive])
  @@map("products")
}

model ProductBarcode {
  id               String  @id @default(uuid()) @db.Uuid
  productId        String  @db.Uuid
  unitConversionId String? @db.Uuid
  barcode          String  @unique @db.VarChar(80)
  isPrimary        Boolean @default(false)

  product        Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  unitConversion ProductUnitConversion? @relation(fields: [unitConversionId], references: [id])

  @@index([productId])
  @@map("product_barcodes")
}

model ProductUnitConversion {
  id             String   @id @default(uuid()) @db.Uuid
  productId      String   @db.Uuid
  uomId          String   @db.Uuid
  factorToBase   Decimal  @db.Decimal(18, 6) // Ej: 1 Rollo = 100.000000 metros
  isPurchaseUnit Boolean  @default(false)
  isSaleUnit     Boolean  @default(true)
  overridePrice  Decimal? @db.Decimal(18, 4)

  product  Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  uom      UnitOfMeasure    @relation(fields: [uomId], references: [id])
  barcodes ProductBarcode[]

  @@unique([productId, uomId])
  @@map("product_unit_conversions")
}

model ProductWarehouseLocation {
  productId  String  @db.Uuid
  locationId String  @db.Uuid
  isPrimary  Boolean @default(true)

  product  Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  location WarehouseLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([productId, locationId])
  @@map("product_warehouse_locations")
}

model ProductKitItem {
  id               String  @id @default(uuid()) @db.Uuid
  kitProductId     String  @db.Uuid
  componentId      String  @db.Uuid
  quantityInBase   Decimal @db.Decimal(18, 4)
  priceWeightRatio Decimal @db.Decimal(7, 6) // Para prorrateo de venta (RF-07)

  kitProduct Product @relation("KitParent", fields: [kitProductId], references: [id], onDelete: Cascade)
  component  Product @relation("KitComponent", fields: [componentId], references: [id])

  @@unique([kitProductId, componentId])
  @@map("product_kit_items")
}

model ProductRelation {
  sourceProductId String @db.Uuid
  targetProductId String @db.Uuid
  relationType    String @db.VarChar(20) // SUBSTITUTE, COMPLEMENTARY

  source Product @relation("ProductSource", fields: [sourceProductId], references: [id], onDelete: Cascade)
  target Product @relation("ProductTarget", fields: [targetProductId], references: [id], onDelete: Cascade)

  @@id([sourceProductId, targetProductId, relationType])
  @@map("product_relations")
}

// INVENTARIO TRIDIMENSIONAL (Bloqueado con FOR UPDATE en CB-04)
model InventoryBalance {
  id           String   @id @default(uuid()) @db.Uuid
  productId    String   @db.Uuid
  warehouseId  String   @db.Uuid
  physicalQty  Decimal  @default(0) @db.Decimal(18, 4) // availableQty + custodyQty
  availableQty Decimal  @default(0) @db.Decimal(18, 4) // Libre para venta
  custodyQty   Decimal  @default(0) @db.Decimal(18, 4) // Facturado pendiente retiro
  inTransitQty Decimal  @default(0) @db.Decimal(18, 4) // Traslados en camino
  averageCost  Decimal  @default(0) @db.Decimal(18, 4) // CPP vigente
  minStock     Decimal  @default(0) @db.Decimal(18, 4)
  maxStock     Decimal  @default(0) @db.Decimal(18, 4)
  salesBlocked Boolean  @default(false) // CB-02 Stock fantasma
  updatedAt    DateTime @updatedAt

  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([productId, warehouseId])
  @@index([warehouseId, salesBlocked])
  @@map("inventory_balances")
}

model ProductSerial {
  id             String    @id @default(uuid()) @db.Uuid
  productId      String    @db.Uuid
  warehouseId    String?   @db.Uuid
  serialNumber   String    @unique @db.VarChar(100)
  status         String    @db.VarChar(25) // IN_STOCK, SOLD, WARRANTY, RETURNED
  goodsReceiptId String?   @db.Uuid
  invoiceId      String?   @db.Uuid
  warrantyUntil  DateTime?
  createdAt      DateTime  @default(now())

  product Product @relation(fields: [productId], references: [id])

  @@index([productId, status])
  @@map("product_serials")
}

// KARDEX INMUTABLE (Protegido con trigger SQL)
model KardexMovement {
  id             String             @id @default(uuid()) @db.Uuid
  productId      String             @db.Uuid
  warehouseId    String             @db.Uuid
  movementType   KardexMovementType
  quantityDelta  Decimal            @db.Decimal(18, 4) // + entrada, - salida
  previousQty    Decimal            @db.Decimal(18, 4)
  newQty         Decimal            @db.Decimal(18, 4)
  unitCost       Decimal            @db.Decimal(18, 4)
  totalCost      Decimal            @db.Decimal(18, 4)
  documentType   String             @db.VarChar(40)
  documentId     String             @db.Uuid
  documentNumber String             @db.VarChar(60)
  userId         String             @db.Uuid
  notes          String?            @db.VarChar(250)
  createdAt      DateTime           @default(now())

  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@index([productId, warehouseId, createdAt])
  @@index([documentType, documentId])
  @@map("kardex_movements")
}

model Supplier {
  id               String   @id @default(uuid()) @db.Uuid
  taxId            String   @unique @db.VarChar(30)
  businessName     String   @db.VarChar(160)
  contactName      String?  @db.VarChar(120)
  email            String?  @db.VarChar(120)
  phone            String?  @db.VarChar(40)
  paymentTermDays  Int      @default(30)
  leadTimeDays     Int      @default(5)
  earlyPayDiscount Decimal  @default(0) @db.Decimal(5, 2)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())

  purchaseOrders  PurchaseOrder[]
  accountsPayable AccountPayable[]

  @@map("suppliers")
}

model PurchaseOrder {
  id          String              @id @default(uuid()) @db.Uuid
  orderNumber String              @unique @db.VarChar(40)
  supplierId  String              @db.Uuid
  warehouseId String              @db.Uuid
  status      PurchaseOrderStatus @default(BORRADOR)
  expectedAt  DateTime?
  subtotal    Decimal             @db.Decimal(18, 4)
  taxTotal    Decimal             @db.Decimal(18, 4)
  total       Decimal             @db.Decimal(18, 4)
  createdBy   String              @db.Uuid
  approvedBy  String?             @db.Uuid
  createdAt   DateTime            @default(now())

  supplier      Supplier            @relation(fields: [supplierId], references: [id])
  warehouse     Warehouse           @relation(fields: [warehouseId], references: [id])
  items         PurchaseOrderItem[]
  goodsReceipts GoodsReceipt[]

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String  @id @default(uuid()) @db.Uuid
  purchaseOrderId String  @db.Uuid
  productId       String  @db.Uuid
  uomCode         String  @db.VarChar(15)
  factorToBase    Decimal @db.Decimal(18, 6)
  orderedQty      Decimal @db.Decimal(18, 4) // Oculto al bodeguero (recepción ciega)
  receivedQty     Decimal @default(0) @db.Decimal(18, 4)
  unitPrice       Decimal @db.Decimal(18, 4)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id])

  @@map("purchase_order_items")
}

model GoodsReceipt {
  id                 String             @id @default(uuid()) @db.Uuid
  receiptNumber      String             @unique @db.VarChar(40)
  purchaseOrderId    String             @db.Uuid
  warehouseId        String             @db.Uuid
  supplierInvoiceNum String             @db.VarChar(60)
  freightCost        Decimal            @default(0) @db.Decimal(18, 4) // Prorrateado al CPP
  insuranceCost      Decimal            @default(0) @db.Decimal(18, 4)
  status             GoodsReceiptStatus @default(BORRADOR)
  hasDiscrepancies   Boolean            @default(false)
  receivedBy         String             @db.Uuid
  approvedBy         String?            @db.Uuid
  createdAt          DateTime           @default(now())

  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id])
  warehouse     Warehouse          @relation(fields: [warehouseId], references: [id])
  items         GoodsReceiptItem[]

  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id                String  @id @default(uuid()) @db.Uuid
  goodsReceiptId    String  @db.Uuid
  productId         String  @db.Uuid
  countedQtyInBase  Decimal @db.Decimal(18, 4) // Conteo ciego del bodeguero
  damagedQtyInBase  Decimal @default(0) @db.Decimal(18, 4)
  expectedQtyInBase Decimal @db.Decimal(18, 4) // Calculado en backend
  landedUnitCost    Decimal @db.Decimal(18, 4) // Costo + flete/seguro prorrateado

  goodsReceipt GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id])

  @@map("goods_receipt_items")
}

model StockTransfer {
  id                String         @id @default(uuid()) @db.Uuid
  transferNumber    String         @unique @db.VarChar(40)
  originWarehouseId String         @db.Uuid
  destWarehouseId   String         @db.Uuid
  status            TransferStatus @default(EN_TRANSITO)
  driverName        String?        @db.VarChar(120)
  vehiclePlate      String?        @db.VarChar(20)
  dispatchedBy      String         @db.Uuid
  receivedBy        String?        @db.Uuid
  dispatchedAt      DateTime       @default(now())
  receivedAt        DateTime?

  originWarehouse Warehouse           @relation("TransferOrigin", fields: [originWarehouseId], references: [id])
  destWarehouse   Warehouse           @relation("TransferDestination", fields: [destWarehouseId], references: [id])
  items           StockTransferItem[]

  @@map("stock_transfers")
}

model StockTransferItem {
  id          String  @id @default(uuid()) @db.Uuid
  transferId  String  @db.Uuid
  productId   String  @db.Uuid
  sentQty     Decimal @db.Decimal(18, 4)
  receivedQty Decimal @default(0) @db.Decimal(18, 4)

  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@map("stock_transfer_items")
}

model CycleCount {
  id          String           @id @default(uuid()) @db.Uuid
  countNumber String           @unique @db.VarChar(40)
  warehouseId String           @db.Uuid
  scope       String           @db.VarChar(120) // ABC_A, PASILLO, URGENTE_CB02
  status      CycleCountStatus @default(ABIERTO)
  createdBy   String           @db.Uuid
  approvedBy  String?          @db.Uuid
  createdAt   DateTime         @default(now())
  closedAt    DateTime?

  warehouse Warehouse        @relation(fields: [warehouseId], references: [id])
  items     CycleCountItem[]

  @@map("cycle_counts")
}

model CycleCountItem {
  id               String   @id @default(uuid()) @db.Uuid
  cycleCountId     String   @db.Uuid
  productId        String   @db.Uuid
  frozenSystemQty  Decimal  @db.Decimal(18, 4) // Oculto al contador (conteo ciego)
  firstCountQty    Decimal? @db.Decimal(18, 4)
  secondCountQty   Decimal? @db.Decimal(18, 4)
  adjustmentReason String?  @db.VarChar(60) // MERMA, ROTURA, ROBO, ERROR_DIGITACION

  cycleCount CycleCount @relation(fields: [cycleCountId], references: [id], onDelete: Cascade)

  @@map("cycle_count_items")
}

// ============================================================================
// MÓDULO 3: CLIENTES, VENTAS POS, CUSTODIA, DESPACHOS Y NOTAS CRÉDITO
// ============================================================================

model PriceList {
  id       String          @id @default(uuid()) @db.Uuid
  code     String          @unique @db.VarChar(30)
  name     String          @db.VarChar(100)
  segment  CustomerSegment
  isActive Boolean         @default(true)

  customers Customer[]
  items     PriceListItem[]

  @@map("price_lists")
}

model PriceListItem {
  id             String  @id @default(uuid()) @db.Uuid
  priceListId    String  @db.Uuid
  productId      String  @db.Uuid
  minQuantity    Decimal @default(1) @db.Decimal(18, 4)
  unitPrice      Decimal @db.Decimal(18, 4)
  maxDiscountPct Decimal @default(0) @db.Decimal(5, 2)

  priceList PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([priceListId, productId, minQuantity])
  @@map("price_list_items")
}

model Customer {
  id                  String          @id @default(uuid()) @db.Uuid
  taxId               String          @unique @db.VarChar(30)
  fullName            String          @db.VarChar(160)
  segment             CustomerSegment @default(MOSTRADOR)
  priceListId         String?         @db.Uuid
  email               String?         @db.VarChar(120)
  phone               String?         @db.VarChar(40)
  creditLimit         Decimal         @default(0) @db.Decimal(18, 4)
  creditUsed          Decimal         @default(0) @db.Decimal(18, 4)
  creditTermDays      Int             @default(0)
  gracePeriodDays     Int             @default(5)
  isBlockedForOverdue Boolean         @default(false)
  authorizedPickups   Json? // Lista de cédulas/nombres autorizados a retirar
  deliveryAddresses   Json?
  advanceBalance      Decimal         @default(0) @db.Decimal(18, 4) // Anticipos / Saldo a favor
  isActive            Boolean         @default(true)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  priceList          PriceList?          @relation(fields: [priceListId], references: [id])
  quotes             Quote[]
  invoices           Invoice[]
  accountsReceivable AccountReceivable[]
  receipts           CustomerReceipt[]

  @@index([fullName])
  @@map("customers")
}

model Quote {
  id          String   @id @default(uuid()) @db.Uuid
  quoteNumber String   @unique @db.VarChar(40)
  customerId  String   @db.Uuid
  sellerId    String   @db.Uuid
  projectName String?  @db.VarChar(150)
  validUntil  DateTime
  status      String   @db.VarChar(25) // VIGENTE, CONVERTIDA, VENCIDA, CANCELADA
  total       Decimal  @db.Decimal(18, 4)
  itemsJson   Json
  createdAt   DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id])

  @@map("quotes")
}

model Invoice {
  id             String              @id @default(uuid()) @db.Uuid
  idempotencyKey String              @unique @db.VarChar(80) // Clave para cola offline (CB-01)
  branchId       String              @db.Uuid
  terminalId     String              @db.Uuid
  cashShiftId    String              @db.Uuid
  customerId     String              @db.Uuid
  sellerId       String              @db.Uuid
  cashierId      String              @db.Uuid
  prefix         String              @db.VarChar(15)
  consecutive    BigInt
  fullNumber     String              @unique @db.VarChar(40)
  isContingency  Boolean             @default(false)
  deliveryMode   InvoiceDeliveryMode @default(RETIRO_INMEDIATO)
  status         InvoiceStatus       @default(EMITIDA_LOCAL)
  subtotal       Decimal             @db.Decimal(18, 4)
  discountTotal  Decimal             @default(0) @db.Decimal(18, 4)
  taxTotal       Decimal             @db.Decimal(18, 4)
  retentionTotal Decimal             @default(0) @db.Decimal(18, 4)
  grandTotal     Decimal             @db.Decimal(18, 4)
  cufe           String?             @db.VarChar(120) // Código fiscal electrónico
  issuedAt       DateTime            @default(now())
  createdAt      DateTime            @default(now())

  branch          Branch                   @relation(fields: [branchId], references: [id])
  cashShift       CashShift                @relation(fields: [cashShiftId], references: [id])
  customer        Customer                 @relation(fields: [customerId], references: [id])
  seller          User                     @relation("InvoiceSeller", fields: [sellerId], references: [id])
  cashier         User                     @relation("InvoiceCashier", fields: [cashierId], references: [id])
  items           InvoiceItem[]
  payments        InvoicePayment[]
  custodyVouchers CustodyDeliveryVoucher[]
  dispatchOrders  DispatchOrder[]
  creditNotes     CreditNote[]
  receivable      AccountReceivable?

  @@index([branchId, issuedAt])
  @@index([customerId, issuedAt])
  @@map("invoices")
}

model InvoiceItem {
  id                   String  @id @default(uuid()) @db.Uuid
  invoiceId            String  @db.Uuid
  productId            String  @db.Uuid
  warehouseId          String  @db.Uuid
  uomCode              String  @db.VarChar(15)
  factorToBase         Decimal @db.Decimal(18, 6)
  soldQty              Decimal @db.Decimal(18, 4)
  soldQtyInBase        Decimal @db.Decimal(18, 4)
  deliveredQtyInBase   Decimal @default(0) @db.Decimal(18, 4) // Control entregas parciales
  custodyPendingInBase Decimal @default(0) @db.Decimal(18, 4) // Saldo en custodia (RF-15)
  unitPrice            Decimal @db.Decimal(18, 4)
  discountAmount       Decimal @default(0) @db.Decimal(18, 4)
  taxRate              Decimal @db.Decimal(7, 4)
  taxAmount            Decimal @db.Decimal(18, 4)
  unitCostSnapshot     Decimal @db.Decimal(18, 4) // CPP congelado al vender (rentabilidad real)
  lineTotal            Decimal @db.Decimal(18, 4)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("invoice_items")
}

model InvoicePayment {
  id                String        @id @default(uuid()) @db.Uuid
  invoiceId         String        @db.Uuid
  method            PaymentMethod
  amount            Decimal       @db.Decimal(18, 4)
  bankName          String?       @db.VarChar(80)
  referenceNumber   String?       @unique @db.VarChar(80) // Unicidad de comprobante (RF-18)
  treasuryConfirmed Boolean       @default(true)
  createdAt         DateTime      @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_payments")
}

model CustodyDeliveryVoucher {
  id             String   @id @default(uuid()) @db.Uuid
  voucherNumber  String   @unique @db.VarChar(40)
  invoiceId      String   @db.Uuid
  pickedUpByName String   @db.VarChar(140)
  pickedUpByDoc  String   @db.VarChar(30)
  signatureUrl   String?  @db.VarChar(255)
  dispatchedBy   String   @db.Uuid
  createdAt      DateTime @default(now())

  invoice Invoice               @relation(fields: [invoiceId], references: [id])
  items   CustodyDeliveryItem[]

  @@map("custody_delivery_vouchers")
}

model CustodyDeliveryItem {
  id            String  @id @default(uuid()) @db.Uuid
  voucherId     String  @db.Uuid
  invoiceItemId String  @db.Uuid
  productId     String  @db.Uuid
  qtyInBase     Decimal @db.Decimal(18, 4)

  voucher CustodyDeliveryVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  @@map("custody_delivery_items")
}

model DispatchOrder {
  id               String         @id @default(uuid()) @db.Uuid
  orderNumber      String         @unique @db.VarChar(40)
  invoiceId        String         @db.Uuid
  deliveryAddress  String         @db.VarChar(250)
  zone             String?        @db.VarChar(60)
  totalWeightKg    Decimal        @default(0) @db.Decimal(12, 4)
  totalVolumeM3    Decimal        @default(0) @db.Decimal(12, 6)
  freightFee       Decimal        @default(0) @db.Decimal(18, 4)
  vehiclePlate     String?        @db.VarChar(20)
  driverName       String?        @db.VarChar(120)
  status           DispatchStatus @default(PENDIENTE_ALISTAMIENTO)
  gatePassToken    String         @unique @db.VarChar(80) // QR único de portería (CB-07)
  gatePassBurnedAt DateTime? // Se sella al salir de patio
  gateCheckedBy    String?        @db.Uuid
  proofPhotoUrl    String?        @db.VarChar(255)
  deliveredAt      DateTime?
  createdAt        DateTime       @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([status, zone])
  @@map("dispatch_orders")
}

model CreditNote {
  id                  String   @id @default(uuid()) @db.Uuid
  creditNoteNumber    String   @unique @db.VarChar(40)
  invoiceId           String   @db.Uuid
  reason              String   @db.VarChar(200)
  isCustodyCancelOnly Boolean  @default(false) // CB-06 sin reingreso físico
  warehouseVerifiedBy String?  @db.Uuid // Inspección física obligatoria (RF-17)
  approvedBy          String   @db.Uuid
  refundDestination   String   @db.VarChar(30) // CARTERA, SALDO_A_FAVOR, EFECTIVO, TRANSFERENCIA
  totalAmount         Decimal  @db.Decimal(18, 4)
  createdAt           DateTime @default(now())

  invoice Invoice          @relation(fields: [invoiceId], references: [id])
  items   CreditNoteItem[]

  @@map("credit_notes")
}

model CreditNoteItem {
  id              String  @id @default(uuid()) @db.Uuid
  creditNoteId    String  @db.Uuid
  productId       String  @db.Uuid
  returnedQty     Decimal @db.Decimal(18, 4)
  returnToDamaged Boolean @default(false)
  unitRefund      Decimal @db.Decimal(18, 4)
  lineTotal       Decimal @db.Decimal(18, 4)

  creditNote CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id])

  @@map("credit_note_items")
}

// ============================================================================
// MÓDULO 4: CAJA CIEGA Y TESORERÍA
// ============================================================================

model CashShift {
  id                String          @id @default(uuid()) @db.Uuid
  branchId          String          @db.Uuid
  terminalId        String          @db.Uuid
  cashierId         String          @db.Uuid
  status            CashShiftStatus @default(ABIERTO)
  openingFloat      Decimal         @db.Decimal(18, 4)
  declaredCash      Decimal?        @db.Decimal(18, 4) // Ingresado a ciegas por cajero
  declaredCards     Decimal?        @db.Decimal(18, 4)
  declaredTransfers Decimal?        @db.Decimal(18, 4)
  declaredChecks    Decimal?        @db.Decimal(18, 4)
  expectedCash      Decimal?        @db.Decimal(18, 4) // Calculado solo al sellar
  expectedCards     Decimal?        @db.Decimal(18, 4)
  expectedTransfers Decimal?        @db.Decimal(18, 4)
  expectedChecks    Decimal?        @db.Decimal(18, 4)
  cashDifference    Decimal?        @db.Decimal(18, 4)
  openedAt          DateTime        @default(now())
  closedAt          DateTime?

  branch        Branch                  @relation(fields: [branchId], references: [id])
  terminal      PosTerminal             @relation(fields: [terminalId], references: [id])
  cashier       User                    @relation(fields: [cashierId], references: [id])
  invoices      Invoice[]
  drops         CashDrop[]
  denominations CashCountDenomination[]

  @@index([terminalId, status])
  @@map("cash_shifts")
}

model CashDrop {
  id          String   @id @default(uuid()) @db.Uuid
  cashShiftId String   @db.Uuid
  amount      Decimal  @db.Decimal(18, 4)
  destination String   @db.VarChar(60) // BOVEDA, CONSIGNACION, CAJA_MENOR
  handedBy    String   @db.Uuid
  receivedBy  String   @db.Uuid // Doble firma digital (RF-19)
  createdAt   DateTime @default(now())

  cashShift CashShift @relation(fields: [cashShiftId], references: [id])

  @@map("cash_drops")
}

model CashCountDenomination {
  id           String  @id @default(uuid()) @db.Uuid
  cashShiftId  String  @db.Uuid
  denomination Decimal @db.Decimal(12, 2) // 100000, 50000, 20000, ..., 100
  quantity     Int
  subtotal     Decimal @db.Decimal(18, 4)

  cashShift CashShift @relation(fields: [cashShiftId], references: [id], onDelete: Cascade)

  @@map("cash_count_denominations")
}

model CustomerReceipt {
  id              String        @id @default(uuid()) @db.Uuid
  receiptNumber   String        @unique @db.VarChar(40)
  customerId      String        @db.Uuid
  cashShiftId     String?       @db.Uuid
  paymentMethod   PaymentMethod
  amount          Decimal       @db.Decimal(18, 4)
  retentionAmount Decimal       @default(0) @db.Decimal(18, 4)
  isAdvance       Boolean       @default(false)
  referenceNumber String?       @unique @db.VarChar(80)
  createdBy       String        @db.Uuid
  createdAt       DateTime      @default(now())

  customer Customer @relation(fields: [customerId], references: [id])

  @@map("customer_receipts")
}

// ============================================================================
// MÓDULO 5: INGRESOS, EGRESOS, CARTERA (CxC) Y PROVEEDORES (CxP)
// ============================================================================

model Expense {
  id                 String   @id @default(uuid()) @db.Uuid
  branchId           String   @db.Uuid
  category           String   @db.VarChar(60)
  costType           String   @db.VarChar(15) // FIJO, VARIABLE
  thirdPartyTaxId    String   @db.VarChar(30)
  thirdPartyName     String   @db.VarChar(140)
  supplierInvoiceNum String   @db.VarChar(60)
  sourceFund         String   @db.VarChar(30) // BANCO, CAJA_MENOR
  amount             Decimal  @db.Decimal(18, 4)
  taxAmount          Decimal  @default(0) @db.Decimal(18, 4)
  supportFileUrl     String?  @db.VarChar(255)
  createdBy          String   @db.Uuid
  expenseDate        DateTime
  createdAt          DateTime @default(now())

  branch Branch @relation(fields: [branchId], references: [id])

  @@unique([thirdPartyTaxId, supplierInvoiceNum]) // Impide factura duplicada (RF-22)
  @@map("expenses")
}

model AccountReceivable {
  id             String   @id @default(uuid()) @db.Uuid
  invoiceId      String   @unique @db.Uuid
  customerId     String   @db.Uuid
  originalAmount Decimal  @db.Decimal(18, 4)
  balanceAmount  Decimal  @db.Decimal(18, 4)
  dueDate        DateTime
  status         String   @db.VarChar(20) // PENDIENTE, PARCIAL, PAGADA, VENCIDA
  createdAt      DateTime @default(now())

  invoice  Invoice  @relation(fields: [invoiceId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId, status, dueDate])
  @@map("accounts_receivable")
}

model AccountPayable {
  id                 String    @id @default(uuid()) @db.Uuid
  supplierId         String    @db.Uuid
  goodsReceiptId     String?   @db.Uuid
  supplierInvoiceNum String    @db.VarChar(60)
  originalAmount     Decimal   @db.Decimal(18, 4)
  balanceAmount      Decimal   @db.Decimal(18, 4)
  dueDate            DateTime
  earlyPayDeadline   DateTime?
  status             String    @db.VarChar(20) // PENDIENTE, PARCIAL, PAGADA
  createdAt          DateTime  @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id])

  @@unique([supplierId, supplierInvoiceNum])
  @@index([dueDate, status])
  @@map("accounts_payable")
}

// ============================================================================
// MÓDULO 6: NÓMINA, ASISTENCIA Y COMISIONES
// ============================================================================

model Employee {
  id              String          @id @default(uuid()) @db.Uuid
  userId          String?         @unique @db.Uuid
  branchId        String          @db.Uuid
  documentNumber  String          @unique @db.VarChar(30)
  fullName        String          @db.VarChar(140)
  position        String          @db.VarChar(80)
  contractType    String          @db.VarChar(40)
  baseSalary      Decimal         @db.Decimal(18, 4)
  commissionBasis CommissionBasis @default(VENTA_RECAUDADA)
  commissionRate  Decimal         @default(0) @db.Decimal(5, 2)
  isActive        Boolean         @default(true)
  hiredAt         DateTime

  user       User?              @relation(fields: [userId], references: [id])
  branch     Branch             @relation(fields: [branchId], references: [id])
  attendance AttendanceRecord[]
  loans      EmployeeLoan[]
  slips      PayrollSlip[]

  @@map("employees")
}

model AttendanceRecord {
  id            String    @id @default(uuid()) @db.Uuid
  employeeId    String    @db.Uuid
  workDate      DateTime  @db.Date
  clockIn       DateTime
  clockOut      DateTime?
  overtimeHours Decimal   @default(0) @db.Decimal(6, 2)
  noveltyType   String?   @db.VarChar(30) // PERMISO, INCAPACIDAD, VACACIONES

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId, workDate])
  @@map("attendance_records")
}

model EmployeeLoan {
  id               String   @id @default(uuid()) @db.Uuid
  employeeId       String   @db.Uuid
  totalAmount      Decimal  @db.Decimal(18, 4)
  remainingAmount  Decimal  @db.Decimal(18, 4)
  installmentValue Decimal  @db.Decimal(18, 4)
  reason           String   @db.VarChar(120)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])

  @@map("employee_loans")
}

model PayrollPeriod {
  id        String        @id @default(uuid()) @db.Uuid
  code      String        @unique @db.VarChar(30)
  startDate DateTime      @db.Date
  endDate   DateTime      @db.Date
  status    PayrollStatus @default(PRE_NOMINA)
  closedAt  DateTime?

  slips PayrollSlip[]

  @@map("payroll_periods")
}

model PayrollSlip {
  id              String  @id @default(uuid()) @db.Uuid
  payrollPeriodId String  @db.Uuid
  employeeId      String  @db.Uuid
  baseEarned      Decimal @db.Decimal(18, 4)
  overtimeEarned  Decimal @default(0) @db.Decimal(18, 4)
  commissionsNet  Decimal @default(0) @db.Decimal(18, 4)
  legalDeductions Decimal @default(0) @db.Decimal(18, 4)
  loanDeductions  Decimal @default(0) @db.Decimal(18, 4)
  otherDeductions Decimal @default(0) @db.Decimal(18, 4)
  netPay          Decimal @db.Decimal(18, 4)

  period   PayrollPeriod @relation(fields: [payrollPeriodId], references: [id])
  employee Employee      @relation(fields: [employeeId], references: [id])

  @@unique([payrollPeriodId, employeeId])
  @@map("payroll_slips")
}

// ============================================================================
// MÓDULO 7: AUDITORÍA INMUTABLE (APPEND-ONLY), ALERTAS ANTIFRAUDE Y OUTBOX
// ============================================================================

model AuditLog {
  id           BigInt   @id @default(autoincrement())
  userId       String?  @db.Uuid
  supervisorId String?  @db.Uuid
  branchId     String?  @db.Uuid
  terminalId   String?  @db.Uuid
  ipAddress    String?  @db.VarChar(45)
  module       String   @db.VarChar(50)
  action       String   @db.VarChar(60)
  entityName   String   @db.VarChar(60)
  entityId     String   @db.VarChar(80)
  beforeData   Json?
  afterData    Json?
  metadata     Json?
  createdAt    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([module, createdAt])
  @@index([entityName, entityId])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

model FraudAlert {
  id          String        @id @default(uuid()) @db.Uuid
  ruleCode    String        @db.VarChar(50) // CART_ITEM_REMOVAL_SPIKE, SHRINKAGE_EXCEEDED, CASH_SHORTAGE
  severity    FraudSeverity
  branchId    String?       @db.Uuid
  userId      String?       @db.Uuid
  description String        @db.Text
  payload     Json?
  isResolved  Boolean       @default(false)
  resolvedBy  String?       @db.Uuid
  createdAt   DateTime      @default(now())

  @@index([isResolved, severity, createdAt])
  @@map("fraud_alerts")
}

model OutboxEvent {
  id          String    @id @default(uuid()) @db.Uuid
  eventType   String    @db.VarChar(80)
  aggregateId String    @db.VarChar(80)
  payload     Json
  processedAt DateTime?
  retryCount  Int       @default(0)
  createdAt   DateTime  @default(now())

  @@index([processedAt, createdAt])
  @@map("outbox_events")
}
