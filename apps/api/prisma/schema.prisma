generator client {
  provider        = "prisma-client-js"
  //previewFeatures = ["postgresqlExtensions"]
  //output   = "../generated/prisma"
}

datasource db {
  provider   = "postgresql"
  //url        = env("DATABASE_URL")
  extensions = [pg_trgm, uuid_ossp(map: "uuid-ossp")]
 }

// ============================================================================
// ENUMS GLOBALES Y FISCALES (COLOMBIA - DIAN)
// ============================================================================

enum RoleCode {
  CAJERO
  VENDEDOR_MOSTRADOR
  BODEGUERO
  DESPACHADOR_LOGISTICA
  CONTADOR_TESORERIA
  ADMIN_GERENCIA
}

enum PermissionAction {
  L // Lectura
  C // Crear
  E // Editar
  A // Aprobar / Autorizar
  N // Anular
}

enum WarehouseType {
  MOSTRADOR
  ALMACEN_CERRADO
  PATIO_GRANELES
  CUARENTENA_AVERIAS
  CUSTODIA
  EN_TRANSITO
}

enum FiscalDocType {
  FACTURA_ELECTRONICA       // FEV DIAN
  DOCUMENTO_EQUIVALENTE_POS // POS Electrónico
  CONTINGENCIA_POS          // CB-01 Contingencia
  NOTA_CREDITO
  NOTA_DEBITO
  REMISION
  RECIBO_CAJA
  ORDEN_COMPRA
  COMPROBANTE_EGRESO
}

enum TaxRegimeCO {
  RESPONSABLE_IVA      // Régimen Común
  NO_RESPONSABLE_IVA
  REGIMEN_SIMPLE       // RST
  GRAN_CONTRIBUYENTE
  AUTORRETENEDOR
}

enum CustomerSegment {
  MOSTRADOR
  MAYORISTA
  CONTRATISTA_OBRA
  CONVENIO_INSTITUCIONAL
}

enum KardexMoveType {
  COMPRA_ENTRADA
  VENTA_SALIDA
  RESERVA_CUSTODIA
  RETIRO_CUSTODIA
  CANCELACION_CUSTODIA
  TRASLADO_SALIDA
  TRASLADO_ENTRADA
  DEVOLUCION_CLIENTE
  DEVOLUCION_PROVEEDOR
  MERMA_CORTE
  AJUSTE_POSITIVO
  AJUSTE_NEGATIVO
  FRACCIONAMIENTO_SALIDA
  FRACCIONAMIENTO_ENTRADA
}

enum InvoiceStatus {
  BORRADOR
  EMITIDA_CONTINGENCIA
  TRANSMITIDA_DIAN
  ANULADA_EN_TURNO
  CON_NOTA_CREDITO
}

enum DispatchStatus {
  PENDIENTE_ALISTAMIENTO
  EN_ALISTAMIENTO
  CARGADO
  EN_RUTA
  ENTREGADO
  ENTREGA_PARCIAL
  RECHAZADO
}

enum PaymentMethod {
  EFECTIVO
  TARJETA_DEBITO
  TARJETA_CREDITO
  TRANSFERENCIA_BANCARIA
  CHEQUE
  CREDITO_INTERNO
  SALDO_A_FAVOR
}

// ============================================================================
// MÓDULO 1: CONFIGURACIÓN, SEGURIDAD (RBAC) Y PARÁMETROS FISCALES (RF-01..04)
// ============================================================================

model Branch {
  id           String        @id @default(uuid())
  code         String        @unique
  name         String
  nit          String
  dv           String        @db.Char(1) // Dígito de verificación DIAN
  address      String
  cityCode     String        // Código DANE municipio
  phone        String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  warehouses   Warehouse[]
  terminals    PosTerminal[]
  sequences    FiscalSequence[]
  users        UserBranch[]
  expenses     Expense[]
}

model Warehouse {
  id                  String              @id @default(uuid())
  branchId            String
  code                String              @unique
  name                String
  type                WarehouseType
  allowsDirectBilling Boolean             @default(false)
  allowsDispatch      Boolean             @default(true)
  allowsReceiving     Boolean             @default(false)
  isActive            Boolean             @default(true)
  branch              Branch              @relation(fields: [branchId], references: [id])
  locations           WarehouseLocation[]
  stockBalances       StockBalance[]
  kardexMovements     KardexMovement[]
  terminals           PosTerminal[]
}

model WarehouseLocation {
  id          String            @id @default(uuid())
  warehouseId String
  zone        String
  aisle       String
  rack        String
  level       String
  barcode     String            @unique
  warehouse   Warehouse         @relation(fields: [warehouseId], references: [id])
  productLocs ProductLocation[]

  @@unique([warehouseId, zone, aisle, rack, level])
}

model User {
  id                    String               @id @default(uuid())
  documentNumber        String               @unique
  fullName              String
  email                 String               @unique
  passwordHash          String               // Argon2id
  supervisorPinHash     String?              // Argon2id (solo supervisores/admin)
  role                  RoleCode
  isActive              Boolean              @default(true)
  sessionTimeoutMinutes Int                  @default(5) // RNF-03
  lastActivityAt        DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  branches              UserBranch[]
  employee              Employee?
  cashShifts            CashShift[]
  auditLogs             AuditLog[]
  requestedOverrides    SupervisorOverride[] @relation("OverrideRequester")
  approvedOverrides     SupervisorOverride[] @relation("OverrideApprover")
}

model UserBranch {
  userId   String
  branchId String
  user     User   @relation(fields: [userId], references: [id])
  branch   Branch @relation(fields: [branchId], references: [id])

  @@id([userId, branchId])
}

model RolePermission {
  id            String           @id @default(uuid())
  role          RoleCode
  resource      String           // Ej: "catalog", "costs_margins", "pos_billing", "blind_count"
  action        PermissionAction
  isRestricted  Boolean          @default(false) // Marca "*" de la matriz RBAC
  hideCostData  Boolean          @default(true)  // Enmascaramiento de costos/márgenes/saldos

  @@unique([role, resource, action])
}

model SupervisorOverride {
  id           String   @id @default(uuid())
  requesterId  String
  approverId   String
  actionCode   String   // Ej: "DISCOUNT_BELOW_MARGIN", "VOID_INVOICE", "CREDIT_OVERRIDE"
  reason       String
  documentType String
  documentId   String?
  terminalId   String?
  createdAt    DateTime @default(now())
  requester    User     @relation("OverrideRequester", fields: [requesterId], references: [id])
  approver     User     @relation("OverrideApprover", fields: [approverId], references: [id])
}

model FiscalSequence {
  id               String        @id @default(uuid())
  branchId         String
  docType          FiscalDocType
  resolutionNumber String?       // Resolución DIAN
  technicalKey     String?       // Clave técnica DIAN (cifrada AES-256)
  prefix           String
  rangeFrom        BigInt
  rangeTo          BigInt
  currentNumber    BigInt
  validFrom        DateTime
  validTo          DateTime
  isActive         Boolean       @default(true)
  isContingency    Boolean       @default(false)
  branch           Branch        @relation(fields: [branchId], references: [id])
  terminals        PosTerminal[]

  @@unique([branchId, docType, prefix])
}

model TaxConfig {
  id          String   @id @default(uuid())
  code        String   @unique // Ej: "IVA_19", "IVA_5", "IVA_0", "RETEFUENTE_2_5", "RETEICA_BOG"
  name        String
  taxType     String   // IVA, RETEFUENTE, RETEIVA, RETEICA, INC
  rate        Decimal  @db.Decimal(6, 4)
  minBaseCop  Decimal  @default(0) @db.Decimal(18, 2) // Base mínima UVT en COP
  isActive    Boolean  @default(true)
  products    Product[]
}

model PosTerminal {
  id                 String          @id @default(uuid())
  branchId           String
  code               String          @unique
  name               String
  defaultWarehouseId String
  fiscalSequenceId   String?
  maxCashLimit       Decimal         @db.Decimal(18, 2) // Tope para alerta de sangría (RF-19)
  hardwareConfig     Json?           // Puertos impresora térmica, láser, báscula serial/USB
  isActive           Boolean         @default(true)
  branch             Branch          @relation(fields: [branchId], references: [id])
  defaultWarehouse   Warehouse       @relation(fields: [defaultWarehouseId], references: [id])
  fiscalSequence     FiscalSequence? @relation(fields: [fiscalSequenceId], references: [id])
  cashShifts         CashShift[]
  drawerEvents       CashDrawerEvent[]
}

model CashDrawerEvent {
  id         String   @id @default(uuid())
  terminalId String
  userId     String
  reason     String   // "SALE", "REFUND", "MANUAL_NO_SALE"
  documentId String?
  isAnomalous Boolean @default(false) // RF-04: apertura fuera de venta/devolución
  createdAt  DateTime @default(now())
  terminal   PosTerminal @relation(fields: [terminalId], references: [id])
}

// ============================================================================
// MÓDULO 2: INVENTARIO, UM, KITS, COMPRAS Y KARDEX (RF-05..11)
// ============================================================================

model Category {
  id                   String     @id @default(uuid())
  parentId             String?
  name                 String
  maxCutMermaPct       Decimal    @default(0) @db.Decimal(5, 2) // CB-05: tope merma técnica (1%-2%)
  minMarginPct         Decimal    @default(15) @db.Decimal(5, 2)
  parent               Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children             Category[] @relation("CategoryTree")
  products             Product[]
}

model UnitOfMeasure {
  id          String       @id @default(uuid())
  code        String       @unique // UND, MTR, KG, GR, ML, LT, BLT, RLL, TON, M3
  name        String
  isFractional Boolean     @default(false)
  products    Product[]
  conversions ProductUom[]
}

model Product {
  id                  String             @id @default(uuid())
  sku                 String             @unique
  manufacturerRef     String?
  name                String
  brand               String?
  categoryId          String
  baseUomId           String
  taxConfigId         String
  specs               Json?              // Calibre, diámetro, amperaje, etc.
  weightKg            Decimal            @default(0) @db.Decimal(12, 4)
  volumeM3            Decimal            @default(0) @db.Decimal(12, 4)
  avgCost             Decimal            @default(0) @db.Decimal(18, 4) // CPP vigente
  lastPurchaseCost    Decimal            @default(0) @db.Decimal(18, 4)
  minMarginPct        Decimal            @db.Decimal(5, 2)
  requiresSerial      Boolean            @default(false)
  isKit               Boolean            @default(false)
  isBlockedForAudit   Boolean            @default(false) // CB-02: bloqueo por stock fantasma
  abcClass            String?            @db.Char(1)     // A, B, C
  isActive            Boolean            @default(true)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  category            Category           @relation(fields: [categoryId], references: [id])
  baseUom             UnitOfMeasure      @relation(fields: [baseUomId], references: [id])
  taxConfig           TaxConfig          @relation(fields: [taxConfigId], references: [id])
  uoms                ProductUom[]
  locations           ProductLocation[]
  stockBalances       StockBalance[]
  kardexMovements     KardexMovement[]
  serials             ProductSerial[]
  kitComponents       KitComponent[]     @relation("KitParent")
  usedInKits          KitComponent[]     @relation("KitChild")
  priceListItems      PriceListItem[]
  substitutes         ProductRelation[]  @relation("RelSource")
  relatedTo           ProductRelation[]  @relation("RelTarget")

  @@index([name])
  @@index([manufacturerRef])
}

model ProductUom {
  id               String        @id @default(uuid())
  productId        String
  uomId            String
  barcode          String        @unique
  conversionFactor Decimal       @db.Decimal(18, 6) // Ej: 1 rollo = 100.000000 metros
  isPurchaseUom    Boolean       @default(false)
  isSaleUom        Boolean       @default(true)
  product          Product       @relation(fields: [productId], references: [id])
  uom              UnitOfMeasure @relation(fields: [uomId], references: [id])

  @@unique([productId, uomId])
}

model ProductRelation {
  sourceProductId String
  targetProductId String
  relationType    String  // "SUBSTITUTE" | "COMPLEMENTARY" (RF-05)
  source          Product @relation("RelSource", fields: [sourceProductId], references: [id])
  target          Product @relation("RelTarget", fields: [targetProductId], references: [id])

  @@id([sourceProductId, targetProductId, relationType])
}

model ProductLocation {
  productId  String
  locationId String
  isPrimary  Boolean           @default(true)
  product    Product           @relation(fields: [productId], references: [id])
  location   WarehouseLocation @relation(fields: [locationId], references: [id])

  @@id([productId, locationId])
}

model KitComponent {
  kitProductId       String
  componentProductId String
  quantityBase       Decimal @db.Decimal(18, 4)
  priceWeightPct     Decimal @db.Decimal(5, 2) // Prorrateo de rentabilidad (RF-07)
  kit                Product @relation("KitParent", fields: [kitProductId], references: [id])
  component          Product @relation("KitChild", fields: [componentProductId], references: [id])

  @@id([kitProductId, componentProductId])
}

model StockBalance {
  id           String    @id @default(uuid())
  productId    String
  warehouseId  String
  physicalQty  Decimal   @default(0) @db.Decimal(18, 4) // Stock físico real
  availableQty Decimal   @default(0) @db.Decimal(18, 4) // Libre para venta (CHECK >= 0)
  custodyQty   Decimal   @default(0) @db.Decimal(18, 4) // Facturado pendiente de retiro (RF-15)
  reservedQty  Decimal   @default(0) @db.Decimal(18, 4) // Reservas temporales de cotización
  minStock     Decimal   @default(0) @db.Decimal(18, 4)
  maxStock     Decimal   @default(0) @db.Decimal(18, 4)
  updatedAt    DateTime  @updatedAt
  product      Product   @relation(fields: [productId], references: [id])
  warehouse    Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([productId, warehouseId])
}

model KardexMovement {
  id            String         @id @default(uuid())
  productId     String
  warehouseId   String
  moveType      KardexMoveType
  previousQty   Decimal        @db.Decimal(18, 4)
  deltaQty      Decimal        @db.Decimal(18, 4)
  newQty        Decimal        @db.Decimal(18, 4)
  unitCost      Decimal        @db.Decimal(18, 4)
  totalCost     Decimal        @db.Decimal(18, 2)
  documentType  String
  documentId    String
  userId        String
  notes         String?
  createdAt     DateTime       @default(now())
  product       Product        @relation(fields: [productId], references: [id])
  warehouse     Warehouse      @relation(fields: [warehouseId], references: [id])

  @@index([productId, warehouseId, createdAt])
}

model ProductSerial {
  id                String   @id @default(uuid())
  productId         String
  serialNumber      String   @unique
  warehouseId       String?
  status            String   // "IN_STOCK", "SOLD", "WARRANTY", "RETURNED"
  purchaseReceiptId String?
  invoiceId         String?
  warrantyEndsAt    DateTime?
  product           Product  @relation(fields: [productId], references: [id])
}

model Supplier {
  id             String          @id @default(uuid())
  nit            String          @unique
  dv             String          @db.Char(1)
  businessName   String
  taxRegime      TaxRegimeCO
  creditDays     Int             @default(30)
  earlyPayDiscPct Decimal        @default(0) @db.Decimal(5, 2)
  email          String?
  phone          String?
  isActive       Boolean         @default(true)
  purchaseOrders PurchaseOrder[]
  payables       AccountPayable[]
}

model PurchaseOrder {
  id            String              @id @default(uuid())
  orderNumber   String              @unique
  supplierId    String
  warehouseId   String
  status        String              // "BORRADOR", "APROBADA", "PARCIAL", "RECIBIDA", "ANULADA"
  expectedDate  DateTime?
  freightCost   Decimal             @default(0) @db.Decimal(18, 2)
  insuranceCost Decimal             @default(0) @db.Decimal(18, 2)
  totalAmount   Decimal             @db.Decimal(18, 2)
  createdById   String
  approvedById  String?
  createdAt     DateTime            @default(now())
  supplier      Supplier            @relation(fields: [supplierId], references: [id])
  items         PurchaseOrderItem[]
  receipts      GoodsReceipt[]
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  productId       String
  uomId           String
  orderedQty      Decimal       @db.Decimal(18, 4) // Oculto al bodeguero en recepción ciega
  receivedQty     Decimal       @default(0) @db.Decimal(18, 4)
  unitCost        Decimal       @db.Decimal(18, 4)
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
}

model GoodsReceipt {
  id                  String             @id @default(uuid())
  purchaseOrderId     String
  supplierInvoiceNo   String
  receivedById        String
  approvedById        String?
  hasDiscrepancy      Boolean            @default(false) // RF-08: acta de discrepancia
  status              String             // "PENDIENTE_APROBACION", "APROBADA", "RECHAZADA"
  createdAt           DateTime           @default(now())
  purchaseOrder       PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id])
  items               GoodsReceiptItem[]
}

model GoodsReceiptItem {
  id             String       @id @default(uuid())
  goodsReceiptId String
  productId      String
  countedQty     Decimal      @db.Decimal(18, 4) // Conteo físico ciego
  damagedQty     Decimal      @default(0) @db.Decimal(18, 4)
  discrepancyQty Decimal      @default(0) @db.Decimal(18, 4)
  goodsReceipt   GoodsReceipt @relation(fields: [goodsReceiptId], references: [id])
}

model StockTransfer {
  id                String              @id @default(uuid())
  transferNumber    String              @unique
  sourceWarehouseId String
  targetWarehouseId String
  status            String              // "EN_TRANSITO", "RECIBIDO", "CON_FALTANTE"
  carrierName       String?
  vehiclePlate      String?
  dispatchedById    String
  receivedById      String?
  dispatchedAt      DateTime            @default(now())
  receivedAt        DateTime?
  items             StockTransferItem[]
}

model StockTransferItem {
  id          String        @id @default(uuid())
  transferId  String
  productId   String
  sentQty     Decimal       @db.Decimal(18, 4)
  receivedQty Decimal?      @db.Decimal(18, 4)
  transfer    StockTransfer @relation(fields: [transferId], references: [id])
}

model CycleCount {
  id            String           @id @default(uuid())
  warehouseId   String
  scopeType     String           // "ABC", "PASILLO", "CATEGORIA", "URGENTE_CB02"
  status        String           // "EN_CONTEO", "RECONTEO", "APROBADO"
  createdById   String
  approvedById  String?
  createdAt     DateTime         @default(now())
  items         CycleCountItem[]
}

model CycleCountItem {
  id             String     @id @default(uuid())
  cycleCountId   String
  productId      String
  frozenSystemQty Decimal   @db.Decimal(18, 4) // Congelado al corte; oculto al conteador
  firstCountQty  Decimal?   @db.Decimal(18, 4)
  secondCountQty Decimal?   @db.Decimal(18, 4)
  reasonCode     String?    // "MERMA", "ROTURA", "ROBO", "ERROR_DIGITACION"
  cycleCount     CycleCount @relation(fields: [cycleCountId], references: [id])
}

// ============================================================================
// MÓDULO 3: VENTAS, POS, CUSTODIA, DESPACHOS Y DEVOLUCIONES (RF-12..17)
// ============================================================================

model PriceList {
  id        String          @id @default(uuid())
  code      String          @unique
  name      String
  segment   CustomerSegment
  isActive  Boolean         @default(true)
  items     PriceListItem[]
  customers Customer[]
}

model PriceListItem {
  id          String    @id @default(uuid())
  priceListId String
  productId   String
  minQty      Decimal   @default(1) @db.Decimal(18, 4) // Escala por volumen
  unitPrice   Decimal   @db.Decimal(18, 2)
  priceList   PriceList @relation(fields: [priceListId], references: [id])
  product     Product   @relation(fields: [productId], references: [id])

  @@unique([priceListId, productId, minQty])
}

model Customer {
  id                 String              @id @default(uuid())
  documentType       String              // "CC", "NIT", "CE"
  documentNumber     String              @unique
  dv                 String?             @db.Char(1)
  fullName           String
  taxRegime          TaxRegimeCO         @default(NO_RESPONSABLE_IVA)
  segment            CustomerSegment     @default(MOSTRADOR)
  priceListId        String
  creditLimit        Decimal             @default(0) @db.Decimal(18, 2)
  creditUsed         Decimal             @default(0) @db.Decimal(18, 2)
  creditDays         Int                 @default(0)
  graceDays          Int                 @default(0)
  isBlockedForArrears Boolean            @default(false)
  authorizedPickers  Json?               // Personas autorizadas a retirar en custodia
  email              String?
  phone              String?
  priceList          PriceList           @relation(fields: [priceListId], references: [id])
  quotations         Quotation[]
  invoices           Invoice[]
  receivables        AccountReceivable[]
}

model Quotation {
  id              String          @id @default(uuid())
  quoteNumber     String          @unique
  customerId      String
  sellerId        String
  projectName     String?
  validUntil      DateTime
  reservesStock   Boolean         @default(false)
  status          String          // "ABIERTA", "CONVERTIDA", "EXPIRADA", "ANULADA"
  totalAmount     Decimal         @db.Decimal(18, 2)
  createdAt       DateTime        @default(now())
  customer        Customer        @relation(fields: [customerId], references: [id])
  items           QuotationItem[]
}

model QuotationItem {
  id          String    @id @default(uuid())
  quotationId String
  productId   String
  uomId       String
  quantity    Decimal   @db.Decimal(18, 4)
  unitPrice   Decimal   @db.Decimal(18, 2)
  quotation   Quotation @relation(fields: [quotationId], references: [id])
}

model Invoice {
  id                  String             @id @default(uuid())
  branchId            String
  terminalId          String
  cashShiftId         String
  customerId          String
  sellerId            String
  cashierId           String
  fiscalDocType       FiscalDocType
  prefix              String
  consecutive         BigInt
  fullNumber          String             @unique
  cufe                String?            @unique // Código Único Factura Electrónica DIAN
  status              InvoiceStatus
  deliveryMode        String             // "RETIRO_INMEDIATO", "DESPACHO_OBRA", "ENTREGA_PARCIAL"
  subtotal            Decimal            @db.Decimal(18, 2)
  discountTotal       Decimal            @db.Decimal(18, 2)
  taxTotal            Decimal            @db.Decimal(18, 2)
  withholdingTotal    Decimal            @default(0) @db.Decimal(18, 2)
  grandTotal          Decimal            @db.Decimal(18, 2)
  isOfflineCreated    Boolean            @default(false) // CB-01
  offlineClientUuid   String?            @unique
  createdAt           DateTime           @default(now())
  customer            Customer           @relation(fields: [customerId], references: [id])
  cashShift           CashShift          @relation(fields: [cashShiftId], references: [id])
  items               InvoiceItem[]
  payments            InvoicePayment[]
  custodyVouchers     CustodyVoucher[]
  dispatchOrders      DispatchOrder[]
  creditNotes         CreditNote[]
}

model InvoiceItem {
  id                  String   @id @default(uuid())
  invoiceId           String
  productId           String
  uomId               String
  quantity            Decimal  @db.Decimal(18, 4)
  baseQuantity        Decimal  @db.Decimal(18, 4)
  unitPrice           Decimal  @db.Decimal(18, 2)
  unitCostSnapshot    Decimal  @db.Decimal(18, 4) // CPP al momento de la venta
  discountAmount      Decimal  @default(0) @db.Decimal(18, 2)
  taxRate             Decimal  @db.Decimal(6, 4)
  taxAmount           Decimal  @db.Decimal(18, 2)
  lineTotal           Decimal  @db.Decimal(18, 2)
  custodyPendingQty   Decimal  @default(0) @db.Decimal(18, 4) // Saldo pendiente de retiro
  invoice             Invoice  @relation(fields: [invoiceId], references: [id])
}

model InvoicePayment {
  id               String        @id @default(uuid())
  invoiceId        String
  method           PaymentMethod
  amount           Decimal       @db.Decimal(18, 2)
  bankName         String?
  referenceNumber  String?       @unique // RF-18: evita reutilizar comprobante
  treasuryVerified Boolean       @default(false)
  invoice          Invoice       @relation(fields: [invoiceId], references: [id])
}

model CustodyVoucher {
  id               String               @id @default(uuid())
  voucherNumber    String               @unique
  invoiceId        String
  pickerName       String
  pickerDocument   String
  signatureUrl     String?
  issuedById       String
  createdAt        DateTime             @default(now())
  invoice          Invoice              @relation(fields: [invoiceId], references: [id])
  items            CustodyVoucherItem[]
}

model CustodyVoucherItem {
  id               String         @id @default(uuid())
  custodyVoucherId String
  invoiceItemId    String
  withdrawnBaseQty Decimal        @db.Decimal(18, 4)
  voucher          CustodyVoucher @relation(fields: [custodyVoucherId], references: [id])
}

model DispatchOrder {
  id               String         @id @default(uuid())
  orderNumber      String         @unique
  invoiceId        String
  deliveryAddress  String
  zone             String
  totalWeightKg    Decimal        @db.Decimal(12, 4)
  totalVolumeM3    Decimal        @db.Decimal(12, 4)
  freightCost      Decimal        @default(0) @db.Decimal(18, 2)
  vehiclePlate     String?
  driverName       String?
  status           DispatchStatus @default(PENDIENTE_ALISTAMIENTO)
  gateQrToken      String         @unique // CB-07: QR de escaneo único en portería
  gateScannedAt    DateTime?
  gateScannedById  String?
  proofPhotoUrl    String?
  proofSignature   String?
  createdAt        DateTime       @default(now())
  invoice          Invoice        @relation(fields: [invoiceId], references: [id])
}

model CreditNote {
  id                  String   @id @default(uuid())
  fullNumber          String   @unique
  cude                String?  @unique // CUDE DIAN
  invoiceId           String
  reason              String
  isCustodyCancel     Boolean  @default(false) // CB-06: cancelación sin reingreso físico
  physicalInspectedBy String?
  destination         String   // "CARTERA", "SALDO_FAVOR", "REEMBOLSO"
  totalAmount         Decimal  @db.Decimal(18, 2)
  approvedById        String
  createdAt           DateTime @default(now())
  invoice             Invoice  @relation(fields: [invoiceId], references: [id])
}

// ============================================================================
// MÓDULO 4: CAJA CIEGA Y TESORERÍA (RF-18..21)
// ============================================================================

model CashShift {
  id                 String           @id @default(uuid())
  terminalId         String
  cashierId          String
  openingBase        Decimal          @db.Decimal(18, 2)
  openedAt           DateTime         @default(now())
  closedAt           DateTime?
  status             String           @default("ABIERTO") // "ABIERTO", "CERRADO"
  declaredBreakdown  Json?            // Conteo ciego por denominación + vouchers
  declaredTotal      Decimal?         @db.Decimal(18, 2)
  theoreticalTotal   Decimal?         @db.Decimal(18, 2) // Oculto al cajero durante arqueo
  varianceAmount     Decimal?         @db.Decimal(18, 2)
  approvedById       String?
  terminal           PosTerminal      @relation(fields: [terminalId], references: [id])
  cashier            User             @relation(fields: [cashierId], references: [id])
  invoices           Invoice[]
  cashDrops          CashDrop[]
}

model CashDrop {
  id              String    @id @default(uuid())
  cashShiftId     String
  amount          Decimal   @db.Decimal(18, 2)
  breakdown       Json
  destination     String    // "BOVEDA", "CONSIGNACION", "CAJA_MENOR"
  cashierId       String
  treasurerId     String
  createdAt       DateTime  @default(now())
  cashShift       CashShift @relation(fields: [cashShiftId], references: [id])
}

// ============================================================================
// MÓDULO 5: INGRESOS, EGRESOS, CxC Y CxP (RF-22..24)
// ============================================================================

model AccountReceivable {
  id            String   @id @default(uuid())
  customerId    String
  invoiceId     String   @unique
  originalAmount Decimal @db.Decimal(18, 2)
  balance       Decimal  @db.Decimal(18, 2)
  dueDate       DateTime
  status        String   // "PENDIENTE", "PARCIAL", "PAGADA", "VENCIDA"
  customer      Customer @relation(fields: [customerId], references: [id])
}

model AccountPayable {
  id                 String   @id @default(uuid())
  supplierId         String
  goodsReceiptId     String?  @unique
  supplierInvoiceNo  String
  originalAmount     Decimal  @db.Decimal(18, 2)
  balance            Decimal  @db.Decimal(18, 2)
  dueDate            DateTime
  earlyPayDeadline   DateTime?
  status             String   // "PENDIENTE", "PROGRAMADA", "PAGADA"
  supplier           Supplier @relation(fields: [supplierId], references: [id])

  @@unique([supplierId, supplierInvoiceNo])
}

model Expense {
  id               String   @id @default(uuid())
  branchId         String
  category         String
  thirdPartyNit    String
  invoiceNumber    String
  amount           Decimal  @db.Decimal(18, 2)
  taxAmount        Decimal  @default(0) @db.Decimal(18, 2)
  isPettyCash      Boolean  @default(false)
  supportUrl       String?
  recordedById     String
  expenseDate      DateTime
  createdAt        DateTime @default(now())
  branch           Branch   @relation(fields: [branchId], references: [id])

  @@unique([thirdPartyNit, invoiceNumber]) // RF-22: evita duplicidad de factura
}

// ============================================================================
// MÓDULO 6: NÓMINA, ASISTENCIA Y COMISIONES (RF-25..27)
// ============================================================================

model Employee {
  id               String             @id @default(uuid())
  userId           String?            @unique
  documentNumber   String             @unique
  fullName         String
  position         String
  contractType     String
  baseSalary       Decimal            @db.Decimal(18, 2)
  commissionMode   String             @default("COLLECTED") // "BILLED" | "COLLECTED" (RF-26)
  commissionRate   Decimal            @default(0) @db.Decimal(5, 2)
  isActive         Boolean            @default(true)
  user             User?              @relation(fields: [userId], references: [id])
  attendances      AttendanceRecord[]
  payrollLines     PayrollLine[]
}

model AttendanceRecord {
  id           String    @id @default(uuid())
  employeeId   String
  checkIn      DateTime
  checkOut     DateTime?
  terminalId   String?
  overtimeHrs  Decimal   @default(0) @db.Decimal(6, 2)
  employee     Employee  @relation(fields: [employeeId], references: [id])
}

model PayrollPeriod {
  id          String        @id @default(uuid())
  code        String        @unique // Ej: "2026-11-Q2"
  startDate   DateTime
  endDate     DateTime
  status      String        // "PRE_NOMINA", "CERRADA"
  lines       PayrollLine[]
}

model PayrollLine {
  id              String        @id @default(uuid())
  payrollPeriodId String
  employeeId      String
  basePay         Decimal       @db.Decimal(18, 2)
  overtimePay     Decimal       @default(0) @db.Decimal(18, 2)
  commissions     Decimal       @default(0) @db.Decimal(18, 2)
  loanDeductions  Decimal       @default(0) @db.Decimal(18, 2)
  legalDeductions Decimal       @default(0) @db.Decimal(18, 2)
  netPay          Decimal       @db.Decimal(18, 2)
  period          PayrollPeriod @relation(fields: [payrollPeriodId], references: [id])
  employee        Employee      @relation(fields: [employeeId], references: [id])
}

// ============================================================================
// MÓDULO 7: AUDITORÍA INMUTABLE (APPEND-ONLY) Y CIERRE CONTABLE (RF-30..31)
// ============================================================================

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?
  ipAddress    String?
  terminalId   String?
  module       String
  action       String   // CREATE, UPDATE, VOID, OVERRIDE, CART_ITEM_REMOVED, DUPLICATE_PRINT
  documentType String?
  documentId   String?
  beforeState  Json?
  afterState   Json?
  createdAt    DateTime @default(now())
  user         User?    @relation(fields: [userId], references: [id])

  @@index([module, action, createdAt])
  @@index([documentType, documentId])
}

model AccountingPeriod {
  id          String    @id @default(uuid())
  year        Int
  month       Int
  status      String    @default("ABIERTO") // "ABIERTO", "CERRADO"
  closedAt    DateTime?
  closedById  String?

  @@unique([year, month])
}